{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baoshan-cms-d1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "www.ysourcetech.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baoshan_cms",
      "database_id": "6d74cbd2-0142-423b-855b-3c8020e791ef",
      "migrations_dir": "migrations"
    }
  ]
}

