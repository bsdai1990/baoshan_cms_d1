# Cloudflare D1 version
# Database binding is configured in wrangler.jsonc as DB.

# Required in production. Set it with:
# npx wrangler secret put CMS_SESSION_SECRET
CMS_SESSION_SECRET=replace-with-a-long-random-string

# Optional local/dev fallback only.
CMS_SESSION_SECRET_DEV=baoshan-cms-local-dev-secret
